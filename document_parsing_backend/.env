# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017/document_processor

# File upload configuration
# Limit in bytes. Default: 50MB (52428800 bytes)
MAX_UPLOAD_SIZE=52428800
# Target directory inside project root to store uploaded files
UPLOADS_DIR=uploads

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3
EMBEDDING_REQUEST_TIMEOUT=30000
OPENAI_API_KEY=mock-key-for-now

# Qdrant Vector Database Configuration
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=document_parsing_key
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_DIMENSIONS=1536
QDRANT_DISTANCE_METRIC=Cosine
QDRANT_SYNC_BATCH_SIZE=100
QDRANT_TIMEOUT=30000

# Retrieval Configuration
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MINIMUM_SCORE=0.7
RETRIEVAL_MAX_RETURNED_CHUNKS=10
RETRIEVAL_ENABLE_NEIGHBOR_EXPANSION=false
RETRIEVAL_ENABLE_RERANKING=false
ENABLE_RETRIEVAL_CACHE=true

# RAG Configuration
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=1000
RAG_LLM_SYSTEM_PROMPT="You are an expert system assistant. Answer the user's question accurately using only the provided context. Cite sources appropriately."
ENABLE_RAG_CACHE=true

# Agent Configuration
AGENT_DEFAULT_MODEL=gpt-4o-mini
AGENT_SYSTEM_PROMPT="You are a helpful AI Agent that orchestrates backend tasks."
AGENT_MAX_ITERATIONS=5
ENABLE_AGENT_MEMORY=true
ENABLE_AGENT_CHECKPOINTING=true
